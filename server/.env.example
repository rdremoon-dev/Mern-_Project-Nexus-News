PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_news?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_random_jwt_secret
CLIENT_URL=http://localhost:5173


# Gmail SMTP (16-character Google App Password; requires 2-Step Verification)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password


# ImageKit CDN Credentials
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id