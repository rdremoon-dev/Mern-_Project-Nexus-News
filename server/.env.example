PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_news?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_random_jwt_secret
CLIENT_URL=http://localhost:5173,https://your-site.netlify.app

# Brevo transactional email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Nexus News


# ImageKit CDN Credentials
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
